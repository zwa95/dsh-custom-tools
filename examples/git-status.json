{
  "name": "git_status",
  "title": "Git 状态",
  "description": "以短格式显示当前仓库的分支、暂存区与工作区改动。只读命令，不修改任何文件。",
  "whenToUse": "当需要知道工作区是否有未提交改动、当前在哪个分支时使用；比 bash 更省 token，也不给出改文件的可能。",
  "mode": "executable",
  "executable": "git",
  "args": [
    {
      "literal": "status"
    },
    {
      "literal": "--short"
    },
    {
      "literal": "--branch"
    }
  ],
  "cwd": ".",
  "approval": "inherit",
  "concurrency": "parallel",
  "timeoutMs": 30000,
  "parameters": {},
  "output": {
    "parse": "text"
  }
}
