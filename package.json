{
  "name": "dsh-custom-tools",
  "version": "0.1.0",
  "description": "Declare local executables, scripts, bash and PowerShell commands as Agent tools with exact argv mapping, hot reload and a settings page.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "zwa95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zwa95/dsh-custom-tools.git"
  },
  "homepage": "https://github.com/zwa95/dsh-custom-tools#readme",
  "bugs": {
    "url": "https://github.com/zwa95/dsh-custom-tools/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "cordis",
    "tool",
    "argv",
    "cli",
    "settings-ui",
    "nodejs",
    "esm"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "node --check client.js && node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  }
}
